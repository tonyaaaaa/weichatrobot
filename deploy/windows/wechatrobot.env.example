# WechatRobot 生产环境配置模板
#
# 部署步骤：
# 1. 在 Windows 服务器创建目录 C:\wxrobot\config
# 2. 将本文件复制为 C:\wxrobot\config\.env
# 3. 填写所有 REPLACE_ 开头的值
# 4. 限制文件权限，只允许 Administrators、IIS API 应用池身份和 Worker 运行身份读取
# 5. 重启 IIS 和 WechatRobot-Worker
#
# 安全要求：
# - 真实 .env 含数据库密码、JWT 密钥和云服务密钥，不得提交 Git、发送到聊天或放入网站静态目录。
# - 系统环境变量优先于本文件，可在紧急情况下覆盖单项配置。
# - 修改本文件后必须重启对应进程，运行中的 API/Worker 不会自动重新加载。
# - 值中可以包含 =、# 和 ;。需要保留首尾空格时，请使用单引号或双引号。

# ---------------------------------------------------------------------------
# API 与 Worker 运行环境
# ---------------------------------------------------------------------------
# API 使用 ASPNETCORE_ENVIRONMENT；Worker 使用 DOTNET_ENVIRONMENT。
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production

# ---------------------------------------------------------------------------
# MySQL：API 与 Worker 共用
# ---------------------------------------------------------------------------
# Server 填 MySQL 内网地址。数据库名称固定为 wechatrobot。
# Password 可以包含 =、# 和 ;，解析器会保留第一个等号之后的全部内容。
ConnectionStrings__WechatRobot=Server=REPLACE_MYSQL_PRIVATE_IP;Port=3306;Database=wechatrobot;User=REPLACE_MYSQL_USER;Password=REPLACE_MYSQL_PASSWORD;CharSet=utf8mb4;

# ---------------------------------------------------------------------------
# 永久主加密密钥：API 与 Worker 共用
# ---------------------------------------------------------------------------
# 必须是“正好 32 字节”的 Base64。可在安全的 PowerShell 终端生成一次：
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# 正式运行后不可更换，否则已加密的机器人标识和模型密钥将无法解密。
WECHATROBOT_MASTER_KEY_BASE64=REPLACE_32_BYTE_BASE64_MASTER_KEY

# ---------------------------------------------------------------------------
# 管理后台 JWT：仅 API 使用
# ---------------------------------------------------------------------------
# SigningKey 至少 32 个字符，应使用独立随机值。
Jwt__Issuer=WechatRobot
Jwt__Audience=WechatRobot.Admin
Jwt__SigningKey=REPLACE_JWT_SIGNING_KEY

# 前后端使用同一个域名，仍保留精确来源校验。不要添加路径或结尾斜杠。
Cors__AllowedOrigins__0=https://wxrobot.aavisa.com

# ---------------------------------------------------------------------------
# Qdrant：API 与 Worker 共用
# ---------------------------------------------------------------------------
# Qdrant 位于 Linux 服务器时填写 Linux 的内网 IP，不要使用 127.0.0.1。
# 只有 Qdrant 与后端位于同一台 Windows 服务器时才可使用 127.0.0.1。
Qdrant__BaseUrl=http://REPLACE_QDRANT_PRIVATE_IP:6333/

# 使用已轮换且未在聊天、日志或源码中出现的新 API Key。
Qdrant__ApiKey=REPLACE_QDRANT_API_KEY

# ---------------------------------------------------------------------------
# WorkTool 全局出口限流：API 与 Worker 共用
# ---------------------------------------------------------------------------
# 使用同一公网出口 IP 的所有 API/Worker 实例必须填写相同 ScopeKey。
# WorkTool 全部接口共享每分钟 60 次上限；不要把不同机器人拆成不同桶。
WorkTool__RateLimit__ScopeKey=default-egress
WorkTool__RateLimit__RequestsPerMinute=60
WorkTool__RateLimit__MaxWaitSeconds=15

# ---------------------------------------------------------------------------
# 阿里云 OSS：API 与 Worker 共用
# ---------------------------------------------------------------------------
Oss__AccessKeyId=REPLACE_OSS_ACCESS_KEY_ID
Oss__AccessKeySecret=REPLACE_OSS_ACCESS_KEY_SECRET
Oss__Bucket=REPLACE_OSS_BUCKET
Oss__Endpoint=oss-cn-shenzhen

# PublicBaseUrl 是上传文件的公网访问前缀，不是 OSS 管理地址：
# - 留空：系统自动生成 https://{Bucket}.{Endpoint}/wechatrobot/...
# - 使用 OSS 自定义域名或 CDN：填写类似 https://files.aavisa.com，必须为 HTTPS
# - 不要填写 https://wxrobot.aavisa.com，除非该域名确实配置了到 OSS 的文件代理
Oss__PublicBaseUrl=

# 当前实现会生成可直接访问的文件 URL；设为 true 表示明确接受 OSS 公读风险。
Oss__PublicReadRiskAccepted=true

# ---------------------------------------------------------------------------
# 阿里云 OCR：Worker 必需，API readiness 也会检查
# ---------------------------------------------------------------------------
ALIBABA_CLOUD_OCR_ACCESS_KEY_ID=REPLACE_OCR_ACCESS_KEY_ID
ALIBABA_CLOUD_OCR_ACCESS_KEY_SECRET=REPLACE_OCR_ACCESS_KEY_SECRET

# ---------------------------------------------------------------------------
# 第一次启动 API：数据库迁移与初始管理员
# ---------------------------------------------------------------------------
# 密码至少 12 位，并包含大写、小写、数字和特殊字符。
BootstrapAdmin__Email=REPLACE_BOOTSTRAP_ADMIN_EMAIL
BootstrapAdmin__Password=REPLACE_BOOTSTRAP_ADMIN_PASSWORD
BootstrapAdmin__DisplayName=系统管理员

# 第一次启动保持 true。迁移和管理员创建成功后改为 false，并清空上面的管理员密码。
Database__ApplyMigrationsOnStartup=true
