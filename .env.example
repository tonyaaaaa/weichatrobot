MYSQL_ROOT_PASSWORD=local-dev-root-password
MYSQL_DATABASE=wechatrobot
MYSQL_USER=wechatrobot
MYSQL_PASSWORD=local-dev-password
MYSQL_PORT=3306
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=local-dev-qdrant-api-key
ALIBABA_CLOUD_OCR_ACCESS_KEY_ID=replace-with-dedicated-ocr-access-key-id
ALIBABA_CLOUD_OCR_ACCESS_KEY_SECRET=replace-with-dedicated-ocr-access-key-secret
WECHATROBOT_MASTER_KEY_BASE64=replace-with-base64-encoded-32-byte-local-key
JWT_SIGNING_KEY=replace-with-local-signing-key-at-least-32-characters
OSS_ACCESS_KEY_ID=replace-with-local-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-local-oss-access-key-secret
OSS_BUCKET=replace-with-local-oss-bucket
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_PUBLIC_BASE_URL=https://replace-with-local-oss-public-base-url
WorkTool__RateLimit__ScopeKey=default-egress
WorkTool__RateLimit__RequestsPerMinute=60
WorkTool__RateLimit__MaxWaitSeconds=15
